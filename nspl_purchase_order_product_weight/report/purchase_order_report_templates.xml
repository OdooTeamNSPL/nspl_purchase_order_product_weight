<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_weight" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//thead/tr" position="inside">
            <th>Weight</th>
        </xpath>
        <xpath expr="//tbody//tr/t[1]" position="inside">
            <td class="text-end">
                <span t-field="order_line.line_total_weight"/>
            </td>
        </xpath>
        <xpath expr="//p[@t-field='o.notes']" position="before">
            <div class="text-end mt-3">
                <strong>Total Weight:</strong>
                <span t-field="o.total_weight"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchase_order_document_inherit_weight" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_price_unit']" position="before">
            <th>Weight</th>
        </xpath>
        <xpath expr="//tbody//tr//td[4]" position="before">
            <td class="text-end">
                <span t-field="line.line_total_weight"/>
            </td>
        </xpath>
        <xpath expr="//p[@t-field='o.notes']" position="before">
            <div class="text-end mt-3">
                <strong>Total Weight:</strong>
                <span t-field="o.total_weight"/>
            </div>
        </xpath>
    </template>
</odoo>
